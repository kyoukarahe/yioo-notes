    "test:security:portable": "node scripts/test-security.mjs --portable",
    "ci:source": "node scripts/ci/source.mjs",
    "ci:verify": "node scripts/ci/verify.mjs",
    "ci:browser": "node scripts/ci/browser.mjs",
    "ci:artifacts": "node scripts/ci/artifacts.mjs",
    "test:guide-steps": "node scripts/test-guide-steps.mjs",
