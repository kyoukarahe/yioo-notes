{
  "name": "yioo-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run sync:styles && astro dev --host 127.0.0.1",
    "sync:styles": "node scripts/sync-styles.mjs",
    "prebuild": "npm run sync:styles",
    "build": "node scripts/astro-build.mjs",
    "check": "astro check",
