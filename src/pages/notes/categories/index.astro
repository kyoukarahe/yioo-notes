---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getActiveCategories } from "../../../lib/categories";
import { getAllPosts } from "../../../lib/posts";
import siteConfig from "../../../config/site.config.json";

const posts = getAllPosts();
const categories = getActiveCategories()
  .map((category) => ({
    ...category,
    count: posts.filter((post) => post.category.id === category.id).length,
  }))
  .filter((category) => category.count > 0);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Yioo Notes 글 분류",
  description: "Yioo Notes의 글을 주제별로 모아 봅니다.",
  url: `${siteConfig.baseUrl}/notes/categories/`,
  hasPart: categories.map((category) => ({
    "@type": "CollectionPage",
    name: category.label,
    url: category.canonicalUrl,
  })),
};
---

<BaseLayout title="글 분류" description="Yioo Notes의 글을 주제별로 모아 봅니다." canonicalPath="/notes/categories/" structuredData={structuredData}>
  <section class="intro">
    <p class="eyebrow">분류</p>
    <h1>글 분류</h1>
    <p>관심 있는 주제에서 글을 찾아보세요.</p>
  </section>
  <ol class="category-list" aria-label="글 분류">
    {
      categories.map((category) => (
        <li>
          <a class="category-list-link" href={category.url}>
            <span>
              <span class="category-title">{category.label}</span>
              <span class="category-description">{category.description}</span>
            </span>
            <span class="category-count">{category.count}</span>
          </a>
        </li>
      ))
    }
  </ol>
</BaseLayout>
