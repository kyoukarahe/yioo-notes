---
import PostList from "../../components/PostList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllPosts } from "../../lib/posts";
import { getActiveCategories } from "../../lib/categories";
import siteConfig from "../../config/site.config.json";

const posts = getAllPosts();
const categories = getActiveCategories().map((category) => ({
  ...category,
  count: posts.filter((post) => post.category.id === category.id).length,
}));
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: siteConfig.title,
  description: siteConfig.description,
  url: `${siteConfig.baseUrl}/notes/`,
  hasPart: posts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.title,
    url: post.canonicalUrl,
    datePublished: post.date,
    dateModified: post.updated ?? post.date,
  })),
};
---

<BaseLayout canonicalPath="/notes/" structuredData={structuredData}>
  <section class="intro">
    <p class="eyebrow">Notes</p>
    <h1>Yioo Notes</h1>
    <p>
      Essays, research notes, and implementation thoughts collected as static
      documents under yioo.link.
    </p>
  </section>
  <nav class="category-strip" aria-label="Note categories">
    <a href="/notes/categories/">Categories</a>
    {
      categories
        .filter((category) => category.count > 0)
        .map((category) => (
          <a href={category.url}>
            {category.label}
            <span>{category.count}</span>
          </a>
        ))
    }
  </nav>
  <PostList posts={posts} />
</BaseLayout>
