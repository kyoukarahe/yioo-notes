---
import type { MarkdownHeading } from "../lib/content-security.mjs";

type Props = {
  headings: MarkdownHeading[];
  lang?: "ko" | "en";
};

const { headings, lang = "ko" } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2);
---

{
  items.length >= 3 && (
    <details class="article-toc" open>
      <summary>{lang === "en" ? "On this page" : "이 글의 목차"}</summary>
      <nav aria-label={lang === "en" ? "Table of contents" : "글 목차"}>
        <ol>
          {items.map((heading) => (
            <li><a href={`#${heading.id}`}>{heading.text}</a></li>
          ))}
        </ol>
      </nav>
    </details>
  )
}
