---
import type { Post } from "../lib/posts";

type Props = {
  posts: Post[];
  lang?: "ko" | "en";
};

const { posts, lang = "ko" } = Astro.props;
---

{
  posts.length > 0 && (
    <aside class="related-posts" aria-labelledby="related-posts-title">
      <p class="eyebrow">{lang === "en" ? "Keep reading" : "이어 읽기"}</p>
      <h2 id="related-posts-title">{lang === "en" ? "Related posts" : "같이 읽을 글"}</h2>
      <ul>
        {posts.map((post) => (
          <li><a href={post.url}>{post.title}</a></li>
        ))}
      </ul>
    </aside>
  )
}
